generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id       String    @id @default(uuid())
  username String    @unique
  email    String    @unique
  password String
}

model Message {
  id        String   @id @default(uuid())
  text      String
  sender    String
  createdAt DateTime @default(now()) @map("created_at")

  @@index([createdAt])
}