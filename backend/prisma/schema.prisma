generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// USERS Y PROFILES

enum Role {
  USER
  ADMIN
  MODERATOR
}

enum Status {
  OFFLINE
  ONLINE
}

model User {
  id                 String   @id @default(uuid())
  email              String   @unique
  username           String   @unique
  passwordHash       String? // Optional if logging in via 42/Google OAuth
  role               Role     @default(USER)
  status             Status   @default(OFFLINE)
  isPrivate          Boolean  @default(false)
  isTwoFactorEnabled Boolean  @default(false)
  twoFactorSecret    String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  //Relations
  profile             Profile?
  sentFriendships     Friendship[] @relation("UserSentFriendships")
  receivedFriendships Friendship[] @relation("UserReceivedFriendships")
  blockedUsers        Block[]      @relation("UserBlocks")
  blockedBy           Block[]      @relation("UserBlockedBy")
  posts               Post[]
  reviews             Review[]
  sentMessages        Message[]    @relation("UserSentMessages")
  receivedMessages    Message[]    @relation("UserReceivedMessages")
}

model Profile {
  id               String   @id @default(uuid())
  userId           String   @unique
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  firstName        String?
  lastName         String?
  avatarUrl        String?  @default("default-avatar.png")
  bio              String?
  preferredCuisine String? // Example: "ITALIAN, JAPANESE, MEXICAN"
  spicyTolerance   Int      @default(0) // Level (0 - 5)
  pricePreference  Int      @default(2) // Range (1 - 4)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

// SOCIAL AND RELATIONS

enum FriendshipStatus {
  PENDING
  ACCEPTED
  DECLINED
}

model Friendship {
  id         String           @id @default(uuid())
  senderId   String
  sender     User             @relation("UserSentFriendships", fields: [senderId], references: [id], onDelete: Cascade)
  receiverId String
  receiver   User             @relation("UserReceivedFriendships", fields: [receiverId], references: [id], onDelete: Cascade)
  status     FriendshipStatus @default(PENDING)
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  @@unique([senderId, receiverId])
}

model Block {
  id        String   @id @default(uuid())
  blockerId String
  blocker   User     @relation("UserBlocks", fields: [blockerId], references: [id], onDelete: Cascade)
  blockedId String
  blocked   User     @relation("UserBlockedBy", fields: [blockedId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([blockerId, blockedId])
}

// CONTENT, RESTAURANTS, DISHES, REVIEWS

model Post {
  id        String   @id @default(uuid())
  title     String
  content   String
  authorId  String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Restaurant {
  id         String @id @default(uuid())
  name       String
  cuisine    String
  priceRange Int

  dishes Dish[]
}

model Dish {
  id           String     @id @default(uuid())
  name         String
  description  String?
  price        Float
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  reviews Review[]
  tags    Tag[]    @relation("DishTags")
}

model Tag {
  id     String @id @default(uuid())
  name   String @unique
  dishes Dish[] @relation("DishTags")
}

model Review {
  id        String   @id @default(uuid())
  rating    Int // Score, e.g., from 1 to 5
  comment   String?
  authorId  String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  dishId    String
  dish      Dish     @relation(fields: [dishId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([authorId, dishId]) // One review per user for each dish
}

// CHAT AND MESSAGING

model Message {
  id         String   @id @default(uuid())
  text       String
  senderId   String
  sender     User     @relation("UserSentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  receiverId String
  receiver   User     @relation("UserReceivedMessages", fields: [receiverId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
}
