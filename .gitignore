
# 1. SYSTEM FILES AND EDITORS
 
# macOS system folder view settings
.DS_Store

# Windows thumbnail cache file
Thumbs.db

# VS Code workspace settings folder
.vscode/

# Unignores shared VS Code settings
!.vscode/settings.json

# Vim editor temporary swap and buffer files
*.swp
*.swo

 
# 2. ENVIRONMENT VARIABLES AND SECRETS

# Main file for local secret environment variables
.env

# Local overrides for environment variables
.env.local
.env.*.local

# Unignores example environment template file
!.env.example

 
# 3. DEPENDENCIES (Node.js)
 
# Node modules directories
node_modules/
/node_modules
apps/*/node_modules

# 4. NESTJS (Backend) - Build and Cache

# NestJS compiled JavaScript output directory
dist/
/dist

# NestJS CLI build cache folder
.nest/

# TypeScript incremental compilation state file
*.tsbuildinfo


# 5. REACT (Frontend) - Build and Cache

# React production build output folder
build/
dist-react/

# Vite local development cache folder
.vite/

 
# 6. LOGS

# Directory and files for runtime/package manager logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

 
